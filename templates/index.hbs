<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI 新闻日报 — {{nowDate}}</title>
  <meta name="description" content="每日 AI 新闻聚合，汇集国内外人工智能最新资讯。自动更新，免费阅读。">
  <link rel="stylesheet" href="style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><defs><linearGradient id='g' x1='0%' y1='0%' x2='100%' y2='100%'><stop offset='0%' stop-color='%233b6df0'/><stop offset='100%' stop-color='%237b2ff0'/></linearGradient></defs><rect width='100' height='100' rx='22' fill='url(%23g)'/><text x='50' y='68' text-anchor='middle' font-size='48'>🤖</text></svg>">
</head>
<body>

<!-- ====== Reading Progress Bar ====== -->
<div class="progress-bar" id="progressBar"></div>

<!-- ====== Live Update Toast ====== -->
<button class="live-toast" id="liveToast" onclick="showNewArticles()">
  <span class="toast-icon">🆕</span>
  <span id="toastMsg">发现新文章</span>
  <span class="toast-count" id="toastCount">0</span>
</button>

<header class="site-header">
  <div class="header-inner">
    <div class="header-left">
      <a href="/" class="logo">
        <span class="logo-icon">🤖</span>
        <span class="logo-text">AI 新闻日报</span>
      </a>
      <div class="header-stats">
        今日 <strong>{{stats.today}} 条</strong> · 共 {{stats.total}} 条
      </div>
    </div>
    <div class="header-right">
      <div class="header-live" id="headerLive">
        <span class="live-dot"></span>
        <span class="live-clock" id="liveClock"></span>
      </div>
      <button class="theme-toggle" id="themeToggle" title="切换深色模式" aria-label="切换深色模式">
        <span class="icon-sun">☀️</span>
        <span class="icon-moon">🌙</span>
      </button>
    </div>
  </div>
</header>

<section class="hero">
  <div class="container">
    <h1 class="hero-title">{{nowDate}} · <span>AI 资讯速览</span></h1>
    <p class="hero-subtitle">汇聚国内外人工智能前沿动态，全天候实时更新<span class="live-pulse-indicator" id="livePulse"><span class="pulse-dot"></span> 实时</span></p>
    <div class="hero-stats">
      <div class="hero-stat">
        <span class="hero-stat-icon">📰</span>
        <span>今日 <strong>{{stats.today}}</strong> 篇</span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat-icon">🇨🇳</span>
        <span>中文 <strong>{{stats.chinese}}</strong> 篇</span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat-icon">🌐</span>
        <span>英文 <strong>{{stats.english}}</strong> 篇</span>
      </div>
    </div>
  </div>
</section>

<main class="content">
  <div class="container">

    <!-- ====== Search Bar ====== -->
    <div class="search-bar">
      <div class="search-wrapper">
        <span class="search-icon">🔍</span>
        <input type="text" class="search-input" id="searchInput" placeholder="搜索新闻标题或摘要…" autocomplete="off">
        <button class="search-clear" id="searchClear" onclick="clearSearch()" title="清除搜索">✕</button>
        <span class="search-hint">/</span>
      </div>
    </div>

    <!-- ====== Language Filter ====== -->
    <div class="filter-bar">
      <button class="filter-tab active" data-filter-group="lang" data-filter-value="all" onclick="setFilter('lang', 'all', this)">全部<span class="filter-count">{{stats.total}}</span></button>
      <button class="filter-tab" data-filter-group="lang" data-filter-value="zh" onclick="setFilter('lang', 'zh', this)">🇨🇳 中文<span class="filter-count">{{stats.chinese}}</span></button>
      <button class="filter-tab" data-filter-group="lang" data-filter-value="en" onclick="setFilter('lang', 'en', this)">🌐 English<span class="filter-count">{{stats.english}}</span></button>
    </div>

    <!-- ====== Time Filter ====== -->
    <div class="filter-bar filter-bar-secondary">
      <button class="filter-tab active" data-filter-group="time" data-filter-value="all" onclick="setFilter('time', 'all', this)">📅 全部时间</button>
      <button class="filter-tab" data-filter-group="time" data-filter-value="今日" onclick="setFilter('time', '今日', this)">📌 今日</button>
      <button class="filter-tab" data-filter-group="time" data-filter-value="昨天" onclick="setFilter('time', '昨天', this)">📌 昨天</button>
      <button class="filter-tab" data-filter-group="time" data-filter-value="earlier" onclick="setFilter('time', 'earlier', this)">📌 更早</button>
    </div>

    <!-- ====== Category Filter ====== -->
    <div class="filter-bar filter-bar-tertiary">
      <button class="filter-tab active" data-filter-group="cat" data-filter-value="all" onclick="setFilter('cat', 'all', this)">🏷️ 全部分类</button>
      <button class="filter-tab" data-filter-group="cat" data-filter-value="大模型" onclick="setFilter('cat', '大模型', this)">大模型</button>
      <button class="filter-tab" data-filter-group="cat" data-filter-value="AI应用" onclick="setFilter('cat', 'AI应用', this)">AI应用</button>
      <button class="filter-tab" data-filter-group="cat" data-filter-value="政策监管" onclick="setFilter('cat', '政策监管', this)">政策监管</button>
      <button class="filter-tab" data-filter-group="cat" data-filter-value="学术研究" onclick="setFilter('cat', '学术研究', this)">学术研究</button>
      <button class="filter-tab" data-filter-group="cat" data-filter-value="开源工具" onclick="setFilter('cat', '开源工具', this)">开源工具</button>
      <button class="filter-tab" data-filter-group="cat" data-filter-value="商业融资" onclick="setFilter('cat', '商业融资', this)">商业融资</button>
      <button class="filter-tab" data-filter-group="cat" data-filter-value="综合" onclick="setFilter('cat', '综合', this)">综合</button>
    </div>

    <!-- ====== Active Filter Indicator ====== -->
    <div class="filter-active" id="filterActive" style="display:none">
      <span id="filterActiveText"></span>
      <button class="filter-clear" onclick="clearAllFilters()">✕ 清除筛选</button>
    </div>

    <!-- ====== No Results ====== -->
    <div class="no-results" id="noResults">
      <div class="no-results-icon">🔍</div>
      <p>没有匹配的新闻</p>
    </div>

    {{#each dateGroups}}
    <section class="date-section" data-date="{{label}}">
      <div class="date-heading">
        <span class="date-icon">{{#if (eq label "今日")}}📅{{else if (eq label "昨天")}}📆{{else}}📋{{/if}}</span>
        <span class="date-label">{{label}}</span>
        <span class="date-count">{{items.length}} 篇</span>
      </div>

      <div class="news-grid">
        {{#each items}}
        <article class="news-card scroll-hidden" data-lang="{{lang}}" data-url="{{link}}" data-date="{{dateLabel}}" data-tags='{{json tags}}' data-pubdate="{{pubDate}}">
          <div class="card-hd">
            <span class="card-source">
              <span class="card-source-dot" style="background:{{sourceColor sourceId}}"></span>
              {{sourceName}}
            </span>
            <span class="card-lang-tag {{#if (eq lang "zh")}}zh{{else}}en{{/if}}">
              {{#if (eq lang "zh")}}中{{else}}EN{{/if}}
            </span>
            <span class="card-time" data-pubdate="{{pubDate}}" title="{{pubDate}}">{{formatDate pubDate}}</span>
          </div>

          <h3 class="card-title">
            <a href="{{link}}" target="_blank" rel="noopener">{{title}}</a>
          </h3>

          <p class="card-snippet">{{snippet}}</p>

          <div class="card-ft">
            <div class="card-tags">
              {{#each tags}}
              <span class="card-tag {{tagClass this}}" onclick="event.stopPropagation(); filterByTag('{{this}}')">{{this}}</span>
              {{/each}}
            </div>
            <a href="{{link}}" target="_blank" rel="noopener" class="read-btn">
              📖 {{#if (eq lang "zh")}}阅读原文{{else}}Read Article{{/if}}
            </a>
          </div>
        </article>
        {{/each}}
      </div>
    </section>
    {{/each}}

    {{#unless dateGroups.length}}
    <div class="empty-state">
      <div class="empty-state-icon">📭</div>
      <p>暂无新闻，请稍后再来</p>
    </div>
    {{/unless}}

  </div>
</main>

<!-- ====== Pagination ====== -->
<div class="pagination" id="pagination">
  <div class="pagination-inner">
    <button class="page-btn" id="prevPage" onclick="goToPage(currentPage - 1)" disabled>‹ 上一页</button>
    <div class="page-numbers" id="pageNumbers"></div>
    <button class="page-btn" id="nextPage" onclick="goToPage(currentPage + 1)" disabled>下一页 ›</button>
    <span class="page-info" id="pageInfo"></span>
  </div>
</div>

<footer class="site-footer">
  <p class="footer-brand">🤖 AI 新闻日报</p>
  <p>每日 8:00 自动更新 · 免费 · 开源</p>
  <p>更新于 {{generatedAt}} <span class="live-badge" id="liveBadge"><span class="live-dot"></span> 实时</span></p>
</footer>

<!-- ====== Back to Top ====== -->
<button class="back-to-top" id="backToTop" onclick="window.scrollTo({top:0,behavior:'smooth'})" title="回到顶部" aria-label="回到顶部">
  <svg viewBox="0 0 44 44">
    <circle class="ring-bg" cx="22" cy="22" r="18"/>
    <circle class="ring-fg" id="ringFg" cx="22" cy="22" r="18"
            stroke-dasharray="113.1" stroke-dashoffset="113.1"/>
  </svg>
  <span class="arrow">↑</span>
</button>

<script>
// ====== State ======
var filterState = { lang: 'all', time: 'all', cat: 'all' };
var searchQuery = '';
var PER_PAGE = 15;
var currentPage = 1;
var totalPages = 0;
var keyFocusIndex = -1;

// ====== Dark Mode ======
(function() {
  var toggle = document.getElementById('themeToggle');
  var html = document.documentElement;

  function setTheme(isDark) {
    html.setAttribute('data-theme', isDark ? 'dark' : '');
    try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch(e) {}
  }

  function getPreferredTheme() {
    try {
      var saved = localStorage.getItem('theme');
      if (saved === 'dark') return true;
      if (saved === 'light') return false;
    } catch(e) {}
    return window.matchMedia('(prefers-color-scheme: dark)').matches;
  }

  var isDark = getPreferredTheme();
  setTheme(isDark);

  toggle.addEventListener('click', function() {
    html.classList.add('theme-transition');
    isDark = !isDark;
    setTheme(isDark);
    setTimeout(function() { html.classList.remove('theme-transition'); }, 400);
  });

  // Listen for system theme changes
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
    if (!localStorage.getItem('theme')) {
      html.classList.add('theme-transition');
      setTheme(e.matches);
      setTimeout(function() { html.classList.remove('theme-transition'); }, 400);
    }
  });
})();

// ====== Click card to open article ======
document.querySelectorAll('.news-card').forEach(function(card) {
  card.addEventListener('click', function(e) {
    if (e.target.closest('.read-btn') || e.target.closest('.card-tag')) return;
    var url = card.dataset.url;
    if (url) window.open(url, '_blank', 'noopener');
  });
});

// ====== Search ======
var searchInput = document.getElementById('searchInput');
var searchClear = document.getElementById('searchClear');

searchInput.addEventListener('input', function() {
  searchQuery = this.value.trim().toLowerCase();
  searchClear.classList.toggle('visible', searchQuery.length > 0);
  currentPage = 1;
  keyFocusIndex = -1;
  clearKeyFocus();
  applyFilters();
});

function clearSearch() {
  searchInput.value = '';
  searchQuery = '';
  searchClear.classList.remove('visible');
  currentPage = 1;
  applyFilters();
  searchInput.focus();
}

// ====== Combined filter + pagination ======
function setFilter(group, value, btn) {
  filterState[group] = value;

  // Update active tab within the same group
  var groupBtns = btn.parentElement.querySelectorAll('[data-filter-group="' + group + '"]');
  groupBtns.forEach(function(b) { b.classList.remove('active'); });
  btn.classList.add('active');

  currentPage = 1;
  keyFocusIndex = -1;
  clearKeyFocus();
  applyFilters();
}

function cardMatchesFilters(card) {
  var lang = filterState.lang;
  var time = filterState.time;
  var cat = filterState.cat;

  if (lang !== 'all' && card.dataset.lang !== lang) return false;
  if (time !== 'all') {
    if (time === 'earlier') {
      if (card.dataset.date === '今日' || card.dataset.date === '昨天') return false;
    } else {
      if (card.dataset.date !== time) return false;
    }
  }
  if (cat !== 'all') {
    var tags = [];
    try { tags = JSON.parse(card.dataset.tags); } catch(e) {}
    if (!tags.includes(cat)) return false;
  }
  if (searchQuery) {
    var title = (card.querySelector('.card-title') || {}).textContent || '';
    var snippet = (card.querySelector('.card-snippet') || {}).textContent || '';
    if (title.toLowerCase().indexOf(searchQuery) === -1 && snippet.toLowerCase().indexOf(searchQuery) === -1) {
      return false;
    }
  }
  return true;
}

function applyFilters() {
  var allCards = document.querySelectorAll('.news-card');
  var matched = [];

  allCards.forEach(function(card) {
    if (cardMatchesFilters(card)) {
      matched.push(card);
    }
  });

  // Pagination
  totalPages = Math.max(1, Math.ceil(matched.length / PER_PAGE));
  if (currentPage > totalPages) currentPage = totalPages;

  var start = (currentPage - 1) * PER_PAGE;
  var end = start + PER_PAGE;
  var pageSlice = matched.slice(start, end);
  var pageSet = new Set(pageSlice);

  allCards.forEach(function(card) {
    card.style.display = pageSet.has(card) ? '' : 'none';
  });

  // Hide empty date sections
  document.querySelectorAll('.date-section').forEach(function(section) {
    var hiddenCards = section.querySelectorAll('.news-card[style*="display: none"]').length;
    var total = section.querySelectorAll('.news-card').length;
    section.style.display = hiddenCards === total ? 'none' : '';
  });

  // No results
  var noResults = document.getElementById('noResults');
  noResults.classList.toggle('visible', matched.length === 0);

  // Filter indicator
  var activeEl = document.getElementById('filterActive');
  var activeText = document.getElementById('filterActiveText');
  var nonDefaultFilters = [];
  if (filterState.lang !== 'all') nonDefaultFilters.push('语言: ' + (filterState.lang === 'zh' ? '中文' : 'English'));
  if (filterState.time !== 'all') nonDefaultFilters.push('时间: ' + (filterState.time === 'earlier' ? '更早' : filterState.time));
  if (filterState.cat !== 'all') nonDefaultFilters.push('分类: ' + filterState.cat);
  if (searchQuery) nonDefaultFilters.push('搜索: ' + searchQuery);

  activeEl.style.display = nonDefaultFilters.length > 0 ? 'flex' : 'none';
  activeText.textContent = '筛选: ' + nonDefaultFilters.join(' · ');

  // Pagination UI
  renderPagination(matched.length);
}

// ====== Pagination rendering ======
function renderPagination(totalFiltered) {
  var pagination = document.getElementById('pagination');
  var pageNumbers = document.getElementById('pageNumbers');
  var prevBtn = document.getElementById('prevPage');
  var nextBtn = document.getElementById('nextPage');
  var pageInfo = document.getElementById('pageInfo');

  if (totalFiltered === 0 || totalPages <= 1) {
    pagination.style.display = 'none';
    return;
  }

  pagination.style.display = 'block';
  pageInfo.textContent = '共 ' + totalFiltered + ' 条，第 ' + currentPage + '/' + totalPages + ' 页';

  prevBtn.disabled = currentPage <= 1;
  nextBtn.disabled = currentPage >= totalPages;

  var html = '';
  var range = 2;

  for (var i = 1; i <= totalPages; i++) {
    if (i === 1 || i === totalPages || (i >= currentPage - range && i <= currentPage + range)) {
      html += '<button class="page-num' + (i === currentPage ? ' active' : '') + '" onclick="goToPage(' + i + ')">' + i + '</button>';
    } else if (html.slice(-6) !== '…</button>' && html.slice(-1) !== '…') {
      html += '<span class="page-ellipsis">…</span>';
    }
  }

  pageNumbers.innerHTML = html;
}

function goToPage(page) {
  if (page < 1 || page > totalPages) return;
  currentPage = page;
  keyFocusIndex = -1;
  clearKeyFocus();
  applyFilters();
  document.querySelector('.content').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// ====== Category tag click ======
function filterByTag(tag) {
  var catBtns = document.querySelectorAll('[data-filter-group="cat"]');
  catBtns.forEach(function(b) {
    b.classList.toggle('active', b.dataset.filterValue === tag);
  });
  filterState.cat = tag;
  currentPage = 1;
  keyFocusIndex = -1;
  clearKeyFocus();
  applyFilters();
  document.querySelector('.filter-bar').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// ====== Clear all filters ======
function clearAllFilters() {
  document.querySelectorAll('[data-filter-group]').forEach(function(btn) {
    var group = btn.dataset.filterGroup;
    if (btn.dataset.filterValue === 'all') {
      btn.classList.add('active');
      filterState[group] = 'all';
    } else {
      btn.classList.remove('active');
    }
  });
  clearSearch();
  currentPage = 1;
  keyFocusIndex = -1;
  clearKeyFocus();
  applyFilters();
}

// ====== Keyboard Navigation ======
function getVisibleCards() {
  var cards = document.querySelectorAll('.news-card');
  var visible = [];
  cards.forEach(function(card) {
    if (card.style.display !== 'none') visible.push(card);
  });
  return visible;
}

function clearKeyFocus() {
  document.querySelectorAll('.news-card.key-focus').forEach(function(c) {
    c.classList.remove('key-focus');
  });
  keyFocusIndex = -1;
}

function focusCard(index) {
  clearKeyFocus();
  var visible = getVisibleCards();
  if (visible.length === 0) return;
  if (index < 0) index = 0;
  if (index >= visible.length) index = visible.length - 1;
  keyFocusIndex = index;
  var card = visible[index];
  card.classList.add('key-focus');
  card.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

document.addEventListener('keydown', function(e) {
  // Don't intercept when typing in input fields
  if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable) {
    if (e.key === 'Escape') {
      e.target.blur();
      clearSearch();
    }
    return;
  }

  // j — next card
  if (e.key === 'j' || e.key === 'J') {
    e.preventDefault();
    var visible = getVisibleCards();
    if (visible.length === 0) return;
    if (keyFocusIndex < 0) keyFocusIndex = 0;
    else keyFocusIndex = Math.min(keyFocusIndex + 1, visible.length - 1);
    focusCard(keyFocusIndex);
    return;
  }

  // k — previous card
  if (e.key === 'k' || e.key === 'K') {
    e.preventDefault();
    var visible = getVisibleCards();
    if (visible.length === 0) return;
    if (keyFocusIndex < 0) keyFocusIndex = visible.length - 1;
    else keyFocusIndex = Math.max(keyFocusIndex - 1, 0);
    focusCard(keyFocusIndex);
    return;
  }

  // / — focus search
  if (e.key === '/') {
    e.preventDefault();
    searchInput.focus();
    return;
  }

  // Escape — clear search, clear focus
  if (e.key === 'Escape') {
    e.preventDefault();
    clearSearch();
    clearKeyFocus();
    return;
  }

  // Enter — open focused card
  if (e.key === 'Enter' && keyFocusIndex >= 0) {
    e.preventDefault();
    var visible = getVisibleCards();
    if (visible[keyFocusIndex]) {
      var url = visible[keyFocusIndex].dataset.url;
      if (url) window.open(url, '_blank', 'noopener');
    }
  }
});

// ====== Reading Progress Bar ======
(function() {
  var bar = document.getElementById('progressBar');
  window.addEventListener('scroll', function() {
    var scrollY = window.scrollY || document.documentElement.scrollTop;
    var docHeight = document.documentElement.scrollHeight - window.innerHeight;
    if (docHeight <= 0) { bar.style.width = '0%'; return; }
    var pct = Math.min(100, Math.max(0, (scrollY / docHeight) * 100));
    bar.style.width = pct + '%';
  });
})();

// ====== Back to Top + Scroll Ring ======
(function() {
  var btn = document.getElementById('backToTop');
  var ring = document.getElementById('ringFg');
  var circumference = 2 * Math.PI * 18; // ~113.1

  window.addEventListener('scroll', function() {
    var scrollY = window.scrollY || document.documentElement.scrollTop;
    var docHeight = document.documentElement.scrollHeight - window.innerHeight;

    // Visibility
    btn.classList.toggle('visible', scrollY > 300);

    // Ring fill
    if (docHeight > 0 && ring) {
      var pct = Math.min(1, Math.max(0, scrollY / docHeight));
      var offset = circumference * (1 - pct);
      ring.setAttribute('stroke-dasharray', circumference);
      ring.setAttribute('stroke-dashoffset', offset);
    }
  });
})();

// ====== Scroll-Reveal via Intersection Observer ======
(function() {
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry, i) {
      if (entry.isIntersecting) {
        var card = entry.target;
        // Stagger within the same grid
        var siblings = Array.from(card.parentElement.children).filter(function(c) {
          return c.classList.contains('scroll-hidden');
        });
        var idx = siblings.indexOf(card);
        var delay = Math.min(idx * 50, 300);

        setTimeout(function() {
          card.classList.remove('scroll-hidden');
          card.classList.add('scroll-revealed');
        }, delay);

        observer.unobserve(card);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' });

  document.querySelectorAll('.news-card.scroll-hidden').forEach(function(card) {
    observer.observe(card);
  });
})();

// ====== Real-time system ======
var realtimeInterval;

function relativeTime(dateStr) {
  var date = new Date(dateStr);
  if (isNaN(date.getTime())) return dateStr;
  var now = new Date();
  var diffMs = now - date;
  var diffSec = Math.floor(diffMs / 1000);
  var diffMin = Math.floor(diffSec / 60);
  var diffH = Math.floor(diffMin / 60);
  var diffD = Math.floor(diffH / 24);

  if (diffSec < 5) return '刚刚';
  if (diffMin < 1) return diffSec + ' 秒前';
  if (diffMin === 1) return '1 分钟前';
  if (diffMin < 60) return diffMin + ' 分钟前';
  if (diffH === 1) return '1 小时前';
  if (diffH < 24) return diffH + ' 小时前';
  if (diffD < 2) return '昨天';
  if (diffD < 7) return diffD + ' 天前';
  return date.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' });
}

function updateTimestamps() {
  var changed = false;
  document.querySelectorAll('.card-time[data-pubdate]').forEach(function(el) {
    var oldText = el.textContent;
    var newText = relativeTime(el.dataset.pubdate);
    if (oldText !== newText) {
      el.textContent = newText;
      el.classList.remove('time-flash');
      void el.offsetWidth;
      el.classList.add('time-flash');
      changed = true;
    }
  });
  if (changed) {
    var badge = document.getElementById('liveBadge');
    if (badge) {
      badge.classList.remove('badge-pulse');
      void badge.offsetWidth;
      badge.classList.add('badge-pulse');
    }
  }
}

function updateClock() {
  var now = new Date();
  var h = String(now.getHours()).padStart(2, '0');
  var m = String(now.getMinutes()).padStart(2, '0');
  var s = String(now.getSeconds()).padStart(2, '0');
  var clock = document.getElementById('liveClock');
  if (clock) clock.textContent = h + ':' + m + ':' + s;
}

function startRealtime() {
  updateClock();
  updateTimestamps();
  setInterval(updateClock, 1000);
  realtimeInterval = setInterval(updateTimestamps, 10000);
}

startRealtime();

// ====== Live Polling for New Articles ======
var knownArticleUrls = [];
var pendingNewArticles = [];
var LIVE_POLL_INTERVAL = 120000; // 2 minutes

// Source color mapping (matches server-side sourceColor helper)
var SOURCE_COLORS = {
  'qbitai': '#e65100', '36kr-ai': '#1976d2', 'leiphone': '#c62828',
  'itjuzi-ai': '#6d28d9', 'techcrunch-ai': '#0a9e4a', 'theverge-ai': '#7b2ff0',
  'mit-tr': '#b91c1c', 'venturebeat-ai': '#2e7d32', 'arstechnica-ai': '#e65100',
  'openai-blog': '#10a37f', 'huggingface-blog': '#f5a623', 'marktechpost': '#3b6df0'
};

// Tag → CSS class mapping
var TAG_CLASSES = {
  '大模型': 'model', 'AI应用': 'app', '政策监管': 'policy',
  '学术研究': 'research', '开源工具': 'opensrc', '商业融资': 'biz', '综合': 'general'
};

// Collect existing article URLs
document.querySelectorAll('.news-card').forEach(function(card) {
  var url = card.dataset.url;
  if (url) knownArticleUrls.push(url);
});

// Build card HTML for a new article
function buildCardHTML(article) {
  var lang = article.lang || 'en';
  var dateLabel = getDateLabel(article.pubDate);
  var langTag = lang === 'zh' ? '中' : 'EN';
  var langClass = lang === 'zh' ? 'zh' : 'en';
  var sourceColor = SOURCE_COLORS[article.sourceId] || '#8e8ea8';
  var readLabel = lang === 'zh' ? '阅读原文' : 'Read Article';
  var timeStr = relativeTime(article.pubDate);

  var tagsHTML = '';
  if (article.tags && article.tags.length) {
    article.tags.forEach(function(tag) {
      var cls = TAG_CLASSES[tag] || 'general';
      tagsHTML += '<span class="card-tag ' + cls + '" onclick="event.stopPropagation(); filterByTag(\'' + escapeHTML(tag) + '\')">' + escapeHTML(tag) + '</span>';
    });
  }

  return '<article class="news-card card-new" data-lang="' + lang + '" data-url="' + escapeHTML(article.link) + '" data-date="' + dateLabel + '" data-tags=\'' + JSON.stringify(article.tags || []) + '\' data-pubdate="' + escapeHTML(article.pubDate) + '">' +
    '<div class="card-hd">' +
      '<span class="card-source">' +
        '<span class="card-source-dot" style="background:' + sourceColor + '"></span>' +
        escapeHTML(article.sourceName || '') +
      '</span>' +
      '<span class="card-lang-tag ' + langClass + '">' + langTag + '</span>' +
      '<span class="card-time" data-pubdate="' + escapeHTML(article.pubDate) + '" title="' + escapeHTML(article.pubDate) + '">' + timeStr + '</span>' +
    '</div>' +
    '<h3 class="card-title"><a href="' + escapeHTML(article.link) + '" target="_blank" rel="noopener">' + escapeHTML(article.title || '') + '</a></h3>' +
    '<p class="card-snippet">' + escapeHTML(article.snippet || '') + '</p>' +
    '<div class="card-ft">' +
      '<div class="card-tags">' + tagsHTML + '</div>' +
      '<a href="' + escapeHTML(article.link) + '" target="_blank" rel="noopener" class="read-btn">📖 ' + readLabel + '</a>' +
    '</div>' +
  '</article>';
}

function escapeHTML(str) {
  if (!str) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function getDateLabel(pubDate) {
  if (!pubDate) return '';
  var d = new Date(pubDate);
  if (isNaN(d.getTime())) return '';
  var today = new Date().toDateString();
  var yesterday = new Date(Date.now() - 86400000).toDateString();
  var dateStr = d.toDateString();
  if (dateStr === today) return '今日';
  if (dateStr === yesterday) return '昨天';
  return d.toLocaleDateString('zh-CN', { month: 'long', day: 'numeric', weekday: 'long' });
}

// Insert new articles into the DOM
function insertNewArticles(articles) {
  // Find or create the "今日" section (new articles are always "today")
  var todaySection = document.querySelector('.date-section[data-date="今日"]');
  var contentContainer = document.querySelector('.content .container');

  if (!todaySection) {
    // Create a new "今日" section
    var sectionHTML = '<section class="date-section" data-date="今日">' +
      '<div class="date-heading">' +
        '<span class="date-icon">📅</span>' +
        '<span class="date-label">今日</span>' +
        '<span class="date-count" id="todayCount">0 篇</span>' +
      '</div>' +
      '<div class="news-grid" id="todayGrid"></div>' +
    '</section>';
    var noResults = document.getElementById('noResults');
    if (noResults) {
      noResults.insertAdjacentHTML('beforebegin', sectionHTML);
    } else {
      contentContainer.insertAdjacentHTML('beforeend', sectionHTML);
    }
    todaySection = document.querySelector('.date-section[data-date="今日"]');
  }

  var grid = todaySection.querySelector('.news-grid');
  if (!grid) return;

  // Build and insert cards in reverse order (oldest first, newest on top)
  var htmlFrag = '';
  for (var i = articles.length - 1; i >= 0; i--) {
    htmlFrag += buildCardHTML(articles[i]);
  }
  grid.insertAdjacentHTML('afterbegin', htmlFrag);

  // Attach click handlers to new cards
  grid.querySelectorAll('.news-card.card-new').forEach(function(card) {
    card.addEventListener('click', function(e) {
      if (e.target.closest('.read-btn') || e.target.closest('.card-tag')) return;
      var url = card.dataset.url;
      if (url) window.open(url, '_blank', 'noopener');
    });
  });

  // Observe new cards for scroll-reveal
  if (typeof IntersectionObserver !== 'undefined') {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.remove('scroll-hidden');
          entry.target.classList.add('scroll-revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    grid.querySelectorAll('.news-card.card-new').forEach(function(card) {
      card.classList.add('scroll-hidden');
      observer.observe(card);
    });
  }
}

// Update all counters on the page
function updateAllCounters() {
  var allCards = document.querySelectorAll('.news-card');
  var totalCount = allCards.length;
  var zhCount = document.querySelectorAll('.news-card[data-lang="zh"]').length;
  var enCount = document.querySelectorAll('.news-card[data-lang="en"]').length;
  var today = new Date().toDateString();
  var todayCount = 0;
  allCards.forEach(function(card) {
    var d = new Date(card.dataset.pubdate);
    if (!isNaN(d.getTime()) && d.toDateString() === today) todayCount++;
  });

  // Header stats
  var headerStats = document.querySelector('.header-stats');
  if (headerStats) {
    headerStats.innerHTML = '今日 <strong>' + todayCount + ' 条</strong> · 共 ' + totalCount + ' 条';
  }

  // Hero stats
  var heroToday = document.querySelector('.hero-stat:nth-child(1) strong');
  var heroZh = document.querySelector('.hero-stat:nth-child(2) strong');
  var heroEn = document.querySelector('.hero-stat:nth-child(3) strong');
  if (heroToday) heroToday.textContent = todayCount;
  if (heroZh) heroZh.textContent = zhCount;
  if (heroEn) heroEn.textContent = enCount;

  // Filter counts
  var langAll = document.querySelector('[data-filter-group="lang"][data-filter-value="all"] .filter-count');
  var langZh = document.querySelector('[data-filter-group="lang"][data-filter-value="zh"] .filter-count');
  var langEn = document.querySelector('[data-filter-group="lang"][data-filter-value="en"] .filter-count');
  if (langAll) langAll.textContent = totalCount;
  if (langZh) langZh.textContent = zhCount;
  if (langEn) langEn.textContent = enCount;

  // Date section counts
  document.querySelectorAll('.date-section').forEach(function(section) {
    var label = section.dataset.date;
    var count = section.querySelectorAll('.news-card').length;
    var countEl = section.querySelector('.date-count');
    if (countEl) countEl.textContent = count + ' 篇';
  });
}

// Show toast notification
function showToast(icon, msg, count) {
  var toast = document.getElementById('liveToast');
  document.getElementById('toastMsg').textContent = msg;
  var countEl = document.getElementById('toastCount');
  if (count) {
    countEl.textContent = count;
    countEl.style.display = '';
  } else {
    countEl.style.display = 'none';
  }
  toast.classList.add('visible');
  // Auto-hide after 8s
  clearTimeout(toast._hideTimeout);
  toast._hideTimeout = setTimeout(function() {
    toast.classList.remove('visible');
  }, 8000);
}

function showNewArticles() {
  var toast = document.getElementById('liveToast');
  toast.classList.remove('visible');
  // Scroll to the first new card
  var firstNew = document.querySelector('.news-card.card-new');
  if (firstNew) {
    firstNew.scrollIntoView({ behavior: 'smooth', block: 'center' });
    firstNew.classList.add('key-focus');
    setTimeout(function() { firstNew.classList.remove('key-focus'); }, 3000);
  }
}

// Poll the API
function pollForUpdates() {
  fetch('/api/news', { cache: 'no-cache' })
    .then(function(r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    })
    .then(function(data) {
      if (!data.articleIds || !data.articleIds.length) return;

      // Find new articles (not in our known list)
      var newArticles = (data.digest || []).filter(function(a) {
        return knownArticleUrls.indexOf(a.link) === -1;
      });

      if (newArticles.length > 0) {
        // Add to known URLs
        newArticles.forEach(function(a) { knownArticleUrls.push(a.link); });

        // Insert into DOM
        insertNewArticles(newArticles);

        // Update counters
        updateAllCounters();

        // Reset to page 1 and re-apply filters
        currentPage = 1;
        keyFocusIndex = -1;
        clearKeyFocus();
        applyFilters();

        // Show toast
        var msg = newArticles.length === 1
          ? '发现 1 篇新文章'
          : '发现 ' + newArticles.length + ' 篇新文章';
        showToast('🆕', msg, newArticles.length);

        // Remove highlight from old "new" cards after animation
        setTimeout(function() {
          document.querySelectorAll('.news-card.card-new').forEach(function(c) {
            c.classList.remove('card-new');
          });
        }, 3000);
      }

      // Update live pulse indicator timestamp
      var pulse = document.getElementById('livePulse');
      if (pulse && data.generatedAt) {
        pulse.title = '数据更新于 ' + new Date(data.generatedAt).toLocaleTimeString('zh-CN');
      }
    })
    .catch(function(err) {
      // Silent failure — don't bother the user
      console.log('Live poll: ' + err.message);
    });
}

// Start polling
livePollTimer = setInterval(pollForUpdates, LIVE_POLL_INTERVAL);
// Also poll once after a short initial delay (let the page settle)
setTimeout(pollForUpdates, 30000);

// ====== Initialize on page load ======
applyFilters();
</script>

