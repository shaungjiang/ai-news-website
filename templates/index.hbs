<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI 新闻日报 — {{nowDate}}</title>
  <meta name="description" content="每日 AI 新闻聚合，汇集国内外人工智能最新资讯。自动更新，免费阅读。">
  <link rel="stylesheet" href="style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><defs><linearGradient id='g' x1='0%' y1='0%' x2='100%' y2='100%'><stop offset='0%' stop-color='%233b6df0'/><stop offset='100%' stop-color='%237b2ff0'/></linearGradient></defs><rect width='100' height='100' rx='22' fill='url(%23g)'/><text x='50' y='68' text-anchor='middle' font-size='48'>🤖</text></svg>">
</head>
<body>

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">
      <span class="logo-icon">🤖</span>
      <span class="logo-text">AI 新闻日报</span>
    </a>
    <div class="header-stats">
      今日 <strong>{{stats.today}} 条</strong> · 共 {{stats.total}} 条
    </div>
  </div>
</header>

<section class="hero">
  <div class="container">
    <h1 class="hero-title">{{nowDate}} · <span>AI 资讯速览</span></h1>
    <p class="hero-subtitle">汇聚国内外人工智能前沿动态，每日 8:00 自动更新</p>
    <div class="hero-stats">
      <div class="hero-stat">
        <span class="hero-stat-icon">📰</span>
        <span>今日 <strong>{{stats.today}}</strong> 篇</span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat-icon">🇨🇳</span>
        <span>中文 <strong>{{stats.chinese}}</strong> 篇</span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat-icon">🌐</span>
        <span>英文 <strong>{{stats.english}}</strong> 篇</span>
      </div>
    </div>
  </div>
</section>

<main class="content">
  <div class="container">

    <!-- ====== Language Filter ====== -->
    <div class="filter-bar">
      <button class="filter-tab active" data-filter-group="lang" data-filter-value="all" onclick="setFilter('lang', 'all', this)">全部<span class="filter-count">{{stats.total}}</span></button>
      <button class="filter-tab" data-filter-group="lang" data-filter-value="zh" onclick="setFilter('lang', 'zh', this)">🇨🇳 中文<span class="filter-count">{{stats.chinese}}</span></button>
      <button class="filter-tab" data-filter-group="lang" data-filter-value="en" onclick="setFilter('lang', 'en', this)">🌐 English<span class="filter-count">{{stats.english}}</span></button>
    </div>

    <!-- ====== Time Filter ====== -->
    <div class="filter-bar filter-bar-secondary">
      <button class="filter-tab active" data-filter-group="time" data-filter-value="all" onclick="setFilter('time', 'all', this)">📅 全部时间</button>
      <button class="filter-tab" data-filter-group="time" data-filter-value="今日" onclick="setFilter('time', '今日', this)">📌 今日</button>
      <button class="filter-tab" data-filter-group="time" data-filter-value="昨天" onclick="setFilter('time', '昨天', this)">📌 昨天</button>
      <button class="filter-tab" data-filter-group="time" data-filter-value="earlier" onclick="setFilter('time', 'earlier', this)">📌 更早</button>
    </div>

    <!-- ====== Category Filter ====== -->
    <div class="filter-bar filter-bar-tertiary">
      <button class="filter-tab active" data-filter-group="cat" data-filter-value="all" onclick="setFilter('cat', 'all', this)">🏷️ 全部分类</button>
      <button class="filter-tab" data-filter-group="cat" data-filter-value="大模型" onclick="setFilter('cat', '大模型', this)">大模型</button>
      <button class="filter-tab" data-filter-group="cat" data-filter-value="AI应用" onclick="setFilter('cat', 'AI应用', this)">AI应用</button>
      <button class="filter-tab" data-filter-group="cat" data-filter-value="政策监管" onclick="setFilter('cat', '政策监管', this)">政策监管</button>
      <button class="filter-tab" data-filter-group="cat" data-filter-value="学术研究" onclick="setFilter('cat', '学术研究', this)">学术研究</button>
      <button class="filter-tab" data-filter-group="cat" data-filter-value="开源工具" onclick="setFilter('cat', '开源工具', this)">开源工具</button>
      <button class="filter-tab" data-filter-group="cat" data-filter-value="商业融资" onclick="setFilter('cat', '商业融资', this)">商业融资</button>
      <button class="filter-tab" data-filter-group="cat" data-filter-value="综合" onclick="setFilter('cat', '综合', this)">综合</button>
    </div>

    <!-- ====== Active Filter Indicator ====== -->
    <div class="filter-active" id="filterActive" style="display:none">
      <span id="filterActiveText"></span>
      <button class="filter-clear" onclick="clearAllFilters()">✕ 清除筛选</button>
    </div>

    {{#each dateGroups}}
    <section class="date-section" data-date="{{label}}">
      <div class="date-heading">
        <span class="date-icon">{{#if (eq label "今日")}}📅{{else if (eq label "昨天")}}📆{{else}}📋{{/if}}</span>
        <span class="date-label">{{label}}</span>
        <span class="date-count">{{items.length}} 篇</span>
      </div>

      <div class="news-grid">
        {{#each items}}
        <article class="news-card" data-lang="{{lang}}" data-url="{{link}}" data-date="{{dateLabel}}" data-tags='{{json tags}}' data-pubdate="{{pubDate}}">
          <div class="card-hd">
            <span class="card-source">
              <span class="card-source-dot" style="background:{{sourceColor sourceId}}"></span>
              {{sourceName}}
            </span>
            <span class="card-lang-tag {{#if (eq lang "zh")}}zh{{else}}en{{/if}}">
              {{#if (eq lang "zh")}}中{{else}}EN{{/if}}
            </span>
            <span class="card-time" data-pubdate="{{pubDate}}" title="{{pubDate}}">{{formatDate pubDate}}</span>
          </div>

          <h3 class="card-title">
            <a href="{{link}}" target="_blank" rel="noopener">{{title}}</a>
          </h3>

          <p class="card-snippet">{{snippet}}</p>

          <div class="card-ft">
            <div class="card-tags">
              {{#each tags}}
              <span class="card-tag {{tagClass this}}" onclick="event.stopPropagation(); filterByTag('{{this}}')">{{this}}</span>
              {{/each}}
            </div>
            <a href="{{link}}" target="_blank" rel="noopener" class="read-btn">
              📖 {{#if (eq lang "zh")}}阅读原文{{else}}Read Article{{/if}}
            </a>
          </div>
        </article>
        {{/each}}
      </div>
    </section>
    {{/each}}

    {{#unless dateGroups.length}}
    <div class="empty-state">
      <div class="empty-state-icon">📭</div>
      <p>暂无新闻，请稍后再来</p>
    </div>
    {{/unless}}

  </div>
</main>

<!-- ====== Pagination ====== -->
<div class="pagination" id="pagination">
  <div class="pagination-inner">
    <button class="page-btn" id="prevPage" onclick="goToPage(currentPage - 1)" disabled>‹ 上一页</button>
    <div class="page-numbers" id="pageNumbers"></div>
    <button class="page-btn" id="nextPage" onclick="goToPage(currentPage + 1)" disabled>下一页 ›</button>
    <span class="page-info" id="pageInfo"></span>
  </div>
</div>

<footer class="site-footer">
  <p class="footer-brand">🤖 AI 新闻日报</p>
  <p>每日 8:00 自动更新 · 免费 · 开源</p>
  <p>更新于 {{generatedAt}} <span class="live-badge" id="liveBadge">🟢 实时</span></p>
</footer>

<button class="back-to-top" id="backToTop" onclick="window.scrollTo({top:0,behavior:'smooth'})" title="回到顶部">↑</button>

<script>
// ====== State ======
var filterState = { lang: 'all', time: 'all', cat: 'all' };
var PER_PAGE = 15;
var currentPage = 1;
var totalPages = 0;

// ====== Click card to open article ======
document.querySelectorAll('.news-card').forEach(card => {
  card.addEventListener('click', (e) => {
    if (e.target.closest('.read-btn') || e.target.closest('.card-tag')) return;
    const url = card.dataset.url;
    if (url) window.open(url, '_blank', 'noopener');
  });
});

// ====== Combined filter + pagination ======
function setFilter(group, value, btn) {
  filterState[group] = value;

  // Update active tab within the same group
  const groupBtns = btn.parentElement.querySelectorAll('[data-filter-group="' + group + '"]');
  groupBtns.forEach(b => b.classList.remove('active'));
  btn.classList.add('active');

  currentPage = 1;
  applyFilters();
}

function applyFilters() {
  const { lang, time, cat } = filterState;

  // --- Step 1: Determine which cards pass the filters ---
  const allCards = document.querySelectorAll('.news-card');
  const matched = [];

  allCards.forEach(card => {
    let match = true;

    if (lang !== 'all' && card.dataset.lang !== lang) match = false;
    if (match && time !== 'all') {
      if (time === 'earlier') {
        if (card.dataset.date === '今日' || card.dataset.date === '昨天') match = false;
      } else {
        if (card.dataset.date !== time) match = false;
      }
    }
    if (match && cat !== 'all') {
      let tags = [];
      try { tags = JSON.parse(card.dataset.tags); } catch(e) {}
      if (!tags.includes(cat)) match = false;
    }

    if (match) matched.push(card);
    // Hide all cards initially; we'll reveal the right ones below
  });

  // --- Step 2: Pagination math ---
  totalPages = Math.max(1, Math.ceil(matched.length / PER_PAGE));
  if (currentPage > totalPages) currentPage = totalPages;

  const start = (currentPage - 1) * PER_PAGE;
  const end = start + PER_PAGE;
  const pageSlice = matched.slice(start, end);
  const pageSet = new Set(pageSlice);

  // --- Step 3: Show/hide each card ---
  allCards.forEach(card => {
    card.style.display = pageSet.has(card) ? '' : 'none';
  });

  // --- Step 4: Hide empty date sections ---
  document.querySelectorAll('.date-section').forEach(section => {
    const hiddenCards = section.querySelectorAll('.news-card[style*="display: none"]').length;
    const total = section.querySelectorAll('.news-card').length;
    section.style.display = hiddenCards === total ? 'none' : '';
  });

  // --- Step 5: Update filter indicator ---
  const activeEl = document.getElementById('filterActive');
  const activeText = document.getElementById('filterActiveText');
  const nonDefaultFilters = [];
  if (lang !== 'all') nonDefaultFilters.push('语言: ' + (lang === 'zh' ? '中文' : 'English'));
  if (time !== 'all') nonDefaultFilters.push('时间: ' + (time === 'earlier' ? '更早' : time));
  if (cat !== 'all') nonDefaultFilters.push('分类: ' + cat);

  activeEl.style.display = nonDefaultFilters.length > 0 ? 'flex' : 'none';
  activeText.textContent = '筛选: ' + nonDefaultFilters.join(' · ');

  // --- Step 6: Update pagination UI ---
  renderPagination(matched.length);
}

// ====== Pagination rendering ======
function renderPagination(totalFiltered) {
  const pagination = document.getElementById('pagination');
  const pageNumbers = document.getElementById('pageNumbers');
  const prevBtn = document.getElementById('prevPage');
  const nextBtn = document.getElementById('nextPage');
  const pageInfo = document.getElementById('pageInfo');

  if (totalFiltered === 0 || totalPages <= 1) {
    pagination.style.display = 'none';
    return;
  }

  pagination.style.display = 'block';
  pageInfo.textContent = '共 ' + totalFiltered + ' 条，第 ' + currentPage + '/' + totalPages + ' 页';

  prevBtn.disabled = currentPage <= 1;
  nextBtn.disabled = currentPage >= totalPages;

  // Build page number buttons
  let html = '';
  const range = 2; // show 2 pages before and after current

  for (let i = 1; i <= totalPages; i++) {
    if (i === 1 || i === totalPages || (i >= currentPage - range && i <= currentPage + range)) {
      html += '<button class="page-num' + (i === currentPage ? ' active' : '') + '" onclick="goToPage(' + i + ')">' + i + '</button>';
    } else if (html.slice(-6) !== '…</button>' && html.slice(-1) !== '…') {
      html += '<span class="page-ellipsis">…</span>';
    }
  }

  pageNumbers.innerHTML = html;
}

function goToPage(page) {
  if (page < 1 || page > totalPages) return;
  currentPage = page;
  applyFilters();
  // Scroll to top of content
  document.querySelector('.content').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// ====== Category tag click ======
function filterByTag(tag) {
  const catBtns = document.querySelectorAll('[data-filter-group="cat"]');
  catBtns.forEach(b => {
    b.classList.toggle('active', b.dataset.filterValue === tag);
  });
  filterState.cat = tag;
  currentPage = 1;
  applyFilters();
  document.querySelector('.filter-bar').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// ====== Clear all filters ======
function clearAllFilters() {
  document.querySelectorAll('[data-filter-group]').forEach(btn => {
    const group = btn.dataset.filterGroup;
    if (btn.dataset.filterValue === 'all') {
      btn.classList.add('active');
      filterState[group] = 'all';
    } else {
      btn.classList.remove('active');
    }
  });
  currentPage = 1;
  applyFilters();
}

// ====== Back to top ======
const backToTopBtn = document.getElementById('backToTop');
window.addEventListener('scroll', () => {
  backToTopBtn.classList.toggle('visible', window.scrollY > 400);
});

// ====== Real-time timestamp update ======
function relativeTime(dateStr) {
  const date = new Date(dateStr);
  if (isNaN(date.getTime())) return dateStr;
  const now = new Date();
  const diffMs = now - date;
  const diffSec = Math.floor(diffMs / 1000);
  const diffMin = Math.floor(diffSec / 60);
  const diffH = Math.floor(diffMin / 60);
  const diffD = Math.floor(diffH / 24);

  if (diffSec < 10) return '刚刚';
  if (diffMin < 1) return diffSec + ' 秒前';
  if (diffMin < 60) return diffMin + ' 分钟前';
  if (diffH < 24) return diffH + ' 小时前';
  if (diffD < 2) return '昨天';
  if (diffD < 7) return diffD + ' 天前';
  return date.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' });
}

function updateTimestamps() {
  document.querySelectorAll('.card-time[data-pubdate]').forEach(el => {
    const oldText = el.textContent;
    const newText = relativeTime(el.dataset.pubdate);
    if (oldText !== newText) {
      el.textContent = newText;
    }
  });
}

// Update every 60 seconds
setInterval(updateTimestamps, 60000);

// Pulse the live badge occasionally to show it's alive
const liveBadge = document.getElementById('liveBadge');
if (liveBadge) {
  setInterval(() => {
    liveBadge.style.opacity = '0.6';
    setTimeout(() => { liveBadge.style.opacity = '1'; }, 200);
  }, 10000);
}

// ====== Initialize on page load ======
applyFilters();
</script>

</body>
</html>
